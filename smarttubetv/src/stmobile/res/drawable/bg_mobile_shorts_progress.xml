<?xml version="1.0" encoding="utf-8"?>
<!-- NEWTUBE(shorts): the Shorts feed's playback progress line (white on a translucent track). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_color_progress_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/mobile_player_on_video" />
            </shape>
        </clip>
    </item>
</layer-list>
