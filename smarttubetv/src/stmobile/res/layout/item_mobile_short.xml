<?xml version="1.0" encoding="utf-8"?>
<!-- NEWTUBE(shorts): one Short page: full-bleed video surface + the metadata overlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextureView
        android:id="@+id/mobile_short_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/mobile_short_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/mobile_short_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/mobile_player_on_video"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mobile_short_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mobile_player_on_video"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
